src: "native/ sources and headers"
cmake: "CMakeLists.txt (C++17)"
core: "optics_core — OBJECT library, -ffp-contract=off"
abi: "_native — pybind11 module"
ntests: "optics_native_tests — native test binary"
mod: "optics/_native.pyd or .so"
wheel: "wheel / editable install"
ctest: "ctest"
pytest: "pytest, ruff, mypy"
ci: "GitHub CI — Linux and Windows"

src -> cmake: "globbed per-module sources"
cmake -> core: "add_library(optics_core OBJECT)"
core -> abi: "pybind11_add_module, OPTICS_BUILD_MODULE=ON"
core -> ntests: "OPTICS_BUILD_TESTS=ON"
abi -> mod: "LIBRARY_OUTPUT_DIRECTORY, install into optics/"
cmake -> wheel: "scikit-build-core packs optics, rendering, ui"
mod -> pytest: "imported by the Python suite"
ntests -> ctest: "native unit cases"
wheel -> pytest: "pip install -e .[dev]"
ci -> ctest: "Release build on both runners"
ci -> ntests: "ASan and UBSan rebuild on Linux"
ci -> pytest: "after lint and type checks"
