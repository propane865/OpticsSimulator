direction: down

inputs: "Inputs" {
  src: "native/ sources"
  cmake: "CMakeLists.txt (C++17)"

  src -> cmake: "globbed sources"
}

targets: "CMake targets: one object library" {
  core: "optics_core: OBJECT library, -ffp-contract=off"
  abi: "_native: pybind11 module"
  mod: "optics/_native.pyd or .so"
  ntests: optics_native_tests
  wheel: "wheel / editable install"

  core -> abi: OPTICS_BUILD_MODULE=ON
  abi -> mod: "install into optics/"
  core -> ntests: OPTICS_BUILD_TESTS=ON
}

gates: "GitHub CI: Linux and Windows" {
  ctest: ctest
  pytest: "pytest, ruff, mypy"
}

inputs.cmake -> targets.core: "add_library(OBJECT)"
inputs.cmake -> targets.wheel: scikit-build-core
targets.mod -> gates.pytest: "Python suite imports it"
targets.ntests -> gates.ctest: "native cases"
targets.wheel -> gates.pytest: "pip install -e .[dev]"
gates -> targets.ntests: "ASan/UBSan rebuild (Linux)"
