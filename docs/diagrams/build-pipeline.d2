grid-rows: 3
grid-gap: 64

cmake: "CMakeLists.txt: C++17, CMake >= 3.24\nnative/ sources listed explicitly"

targets: "CMake targets: one object library" {
  grid-columns: 2
  grid-gap: 26
  core: "optics_core: OBJECT library\n-ffp-contract=off (GNU/Clang)"
  ntests: "optics_native_tests\nOPTICS_BUILD_TESTS=ON\nlinks optics_core"
  mod: "_native: pybind11 module\nOPTICS_BUILD_MODULE=ON\n-> optics/_native.(pyd | so)"
  wheel: "wheel / editable install\nscikit-build-core (+ main.ui, JSON)"

  core -> ntests
  core -> mod
}

ci: "GitHub CI: Linux and Windows" {
  grid-rows: 3
  grid-gap: 26
  ctest: "ctest (Release), both runners\n+ ASan/UBSan rebuild on Linux"
  lint: "ruff check .; mypy\noptics rendering ui tests"
  pytest: "pytest\n(QT_QPA_PLATFORM=offscreen)"

  ctest -> lint: green
  lint -> pytest: green
}

cmake -> targets: add_library(OBJECT)
targets -> ci: "ctest the native binary;\npip install -e .[dev] for pytest"
