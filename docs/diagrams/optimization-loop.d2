direction: down

ui: "UI thread (Qt)" {
  ed: "analysis.py: z-lock table, image-plane lock, log"
  work: "optimize.py: LayoutOptimizer (QThread)"

  work -> ed: "progress, result"
}

py: "optics/optimizer/" {
  api: "api.py: validate, build problem, solve, interpret"
  cfg: "config.py: LensOptimization to OptimizerSettings"
  layout: "layout.py: transform-only variants, bounds"
  res: "OptimizationResult: layout, plane_transform, diagnostics"

  api -> cfg: settings
  api -> layout: "free z keys, image plane"
  api -> res: "layout + plane_transform"
}

nat: "native search" {
  search: "optimizing/: bounded DE, gated Nelder-Mead polish"
  fit: "fit: per-object-point spot radius"
  acc: "acceptance contract"

  search <-> fit: "cost per candidate <-> focus measure"
  search -> acc: best candidate
}

ui.ed -> ui.work: "start, cancel"
ui.work -> py.api: solve
py.cfg -> nat.search: OptimizerSettings
py.layout -> nat.search: "bounded space"
nat.acc -> py.api: "layout or failure reason"
py.res -> ui.work: outcome
