grid-rows: 3
grid-gap: 70

ui: "UI thread (Qt)" {
  grid-rows: 2
  grid-gap: 26
  ed: "analysis.py: z-locks, plane lock,\nmagnification target, log"
  work: "optimize.py: LayoutOptimizer\n(daemon thread)"

  ed <-> work: "start  /  progress, finished, failed"
}

py: "optics/optimizer/" {
  grid-rows: 2
  grid-gap: 26
  build: "config.py: OptimizerSettings\nlayout.py: units, windows"
  api: "api.py: validate, build, solve,\ninterpret"

  api -> build: "settings + bounded problem"
}

nat: "native search: coarse -> fine" {
  grid-rows: 5
  grid-gap: 26
  coarse: "coarse DE (Latin hypercube),\nbehind a shallow pilot gate"
  med: "promotion gate +\nmedium-fidelity re-rank"
  val: "whole-fan validation:\nthe only success gate"
  polish: "Nelder-Mead polish,\ngated on near-acceptance blur"
  acc: "acceptance: spot-radius and\nmagnification tolerances"

  coarse -> med: "archive"
  med -> val: "finalists, best first"
  val -> polish: "winner, or near-focus best"
  polish -> acc: "re-checked"
}

ui.work <-> py: "solve  /  OptimizationResult on the UI thread"
py.api <-> nat.coarse: "OptimizerSettings + box  /  accepted layout or failure"
