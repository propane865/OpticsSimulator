ed: "editors/analysis.py — element z-lock table, image-plane lock, log"
worker: "optimize.py — LayoutOptimizer worker thread"
api: "optimizer/api.py — validate, build problem, solve, interpret"
cfg: "optimizer/config.py — LensOptimization to native OptimizerSettings"
layout: "optimizer/layout.py — transform-only stack variants, submodule bounds"
nat: "native optimizing/ — Latin-hypercube bounded DE, then gated Nelder–Mead polish"
fit: "native fit + objective — pooled per-object-point spot radius"
acc: "native acceptance — focus-acceptance contract"
result: "OptimizationResult — layout, plane transform, diagnostics"

ed -> worker: start and cancel
worker -> api: solve off the UI thread
api -> cfg: build native settings
api -> layout: free element z keys and image plane
layout -> nat: bounded candidate space
nat -> fit: cost per candidate stack
fit -> nat: spot-radius focus measure
nat -> acc: best candidate
acc -> api: accepted layout or failure reason
api -> result: layout plus plane_transform fit
result -> worker: outcome
worker -> ed: progress and result on the UI thread
