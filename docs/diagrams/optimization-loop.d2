direction: down

ui: "UI thread (Qt)" {
  direction: right
  ed: "analysis.py: z-locks, plane\nlock, magnification target, log"
  work: "optimize.py: LayoutOptimizer\n(daemon thread); start down,\nprogress / finished / failed up"

  ed <-> work
}

py: "optics/optimizer/" {
  direction: right
  api: "api.py: validate, build, solve,\ninterpret"
  build: "config.py: OptimizerSettings;\nlayout.py: units and windows -\nthe bounded problem"

  api -> build
}

nat: "native search: coarse -> fine" {
  direction: right
  gate: "pure-arithmetic precheck +\nshallow pilot trace: hopeless\ntrials bill no coarse eval"
  coarse: "coarse DE (Latin hypercube) fills\na diverse archive"
  med: "promotion gate: a deterministic subset\ngoes to medium-fidelity re-rank"
  acc: "acceptance: spot-radius and\nmagnification tolerances -\nwhat Python reads back"
  polish: "Nelder-Mead refinement on the winner\nor a near-focus best, gated on\nnear-acceptance blur"
  val: "whole-fan validation: the only place\nsuccess can occur;\nfinalists, best first"

  gate -> coarse: survivors
  coarse -> med: archive
  med -> val
  val -> polish: "winner, or near-focus best"
  polish -> acc: re-checked
}

ui.work <-> py: "solve  /  OptimizationResult on the UI thread"
py.api -> nat.gate: "OptimizerSettings + box"
nat.acc -> py.api
