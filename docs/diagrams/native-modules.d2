grid-rows: 3
grid-gap: 48

consumers: "consumers: not layers" {
  grid-columns: 2
  grid-gap: 26
  bindings: "bindings/:\npybind11 registration"
  ntests: "native/tests/:\nctest binary"
}

kernels: "kernel layers: arrows are includes" {
  grid-rows: 5
  grid-gap: 26
  optimizing: "optimizing/: coarse DE -> promotion -> medium\n-> whole-fan validate -> gated NM; objective, fit\nalso includes tracing (transform-only variants)"
  measurement: "measurement/: power accumulation, Wendland C2\nreconstruction; also includes intersection"
  tracing: "tracing/: element, trace-stack state, refraction,\nstack walk; also includes geometry"
  intersection: "intersection/: Newton solver, closed form,\ninversion, rim mesh"
  geometry: "geometry/: surface models, apertures,\nworld normals"

  optimizing -> measurement: "plane hits per candidate"
  measurement -> tracing: persistent stack walk
  tracing -> intersection: surface hits per hop
  intersection <-> geometry: the one header cycle
}

base: "leaf layers" {
  grid-columns: 2
  grid-gap: 26
  expression: "expression/: parser,\ntree interpreter"
  common: "common/: math, linalg,\nparallel dispatch, constants"
}

consumers -> kernels: "all layers registered, all TUs linked"
kernels -> base: "expression: lowered tree (intersection,\ngeometry); common: math, parallel, constants"
