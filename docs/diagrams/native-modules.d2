direction: down

consumers: {
  direction: right
  bindings: "bindings/: pybind11 registration"
  ntests: "native/tests/: ctest binary"
}

kernels: "kernel layers: each arrow is an include of optics/..." {
  optimizing: "optimizing/: DE + gated Nelder-Mead, objective, fit, acceptance"
  measurement: "measurement/: power accumulation, Wendland C2 reconstruction"
  tracing: "tracing/: element, trace-stack state, refraction, stack walk"
  intersection: "intersection/: Newton solver, closed-form, inversion, rim mesh"
  geometry: "geometry/: surface models, apertures, world normals"

  optimizing -> measurement: candidate stacks
  optimizing -> tracing: transform-only stack variants
  measurement -> tracing: persistent stack walk
  measurement -> intersection: plane hit primitives
  tracing -> intersection: surface hits per hop
  tracing -> geometry: surface descriptors, normals
  intersection <-> geometry: "cycle: surfaces, apertures, plane, rim mesh"
}

expression: "expression/: parser, tree interpreter"
common: "common/: vector/matrix math, linalg, parallel dispatch, constants"

consumers -> kernels: "all layers registered, all TUs linked"
kernels -> expression: "lowered tree, from intersection and geometry"
kernels -> common: "math, parallel dispatch, constants"
