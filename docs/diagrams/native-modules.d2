direction: down

consumers: "consumers" {
  direction: right
  bindings: "bindings/: pybind11 registration"
  ntests: "native/tests/: ctest binary"
}

kernels: "kernel layers: each arrow is an include of optics/..." {
  optimizing: "optimizing/: DE + gated Nelder-Mead, objective, fit, acceptance"
  measurement: "measurement/: power accumulation, Wendland C2 reconstruction"
  tracing: "tracing/: element and trace-stack state, refraction, stack walk"
  intersection: "intersection/: Newton solver, classified closed-form, inversion, rim mesh"
  geometry: "geometry/: surface models, apertures, world normals"

  optimizing -> measurement: evaluate candidate stacks
  optimizing -> tracing: transform-only stack variants
  measurement -> tracing: walk the persistent stack
  measurement -> intersection: plane hit primitives
  tracing -> intersection: surface hits per hop
  tracing -> geometry: surface descriptors and normals
  intersection <-> geometry: "header cycle: surfaces and apertures, plane and rim mesh"
}

expression: "expression/: parser and tree interpreter"
common: "common/: vector/matrix math, linalg, parallel dispatch, constants"

consumers -> kernels: "bindings register every layer, ctest links every TU"
kernels -> expression: intersection and geometry evaluate the lowered tree
kernels -> common: math and parallel dispatch from every module
