direction: right

consumers: "consumers: not layers" {
  direction: down
  bindings: "bindings/: pybind11 registration\nof every layer"
  ntests: "native/tests/:\nctest binary"
}

kernels: "kernel layers: arrows are includes" {
  direction: down
  optimizing: "optimizing/: one driver, ray budgets are the dial:\nprecheck+pilot -> coarse DE -> promotion -> medium ->\nwhole-fan validate -> gated NM; also includes tracing"
  measurement: "measurement/: power accumulation, Wendland C2\nreconstruction; also includes intersection"
  tracing: "tracing/: element, trace-stack state, refraction,\nstack walk; also includes geometry"
  intersection: "intersection/: Surface operations, Newton solver,\nclosed form, inversion, rim mesh"
  geometry: "geometry/: surface models, apertures, world normals,\nkernel_layout.hpp (shared data layouts)"

  optimizing -> measurement: "plane hits per candidate"
  measurement -> tracing: persistent stack walk
  tracing -> intersection: surface hits per hop
  intersection -> geometry: surface and aperture models,\nkernel layouts
}

base: "leaf layers" {
  direction: down
  expression: "expression/: parser and tree interpreter"
  common: "common/: vector and matrix math, linalg,\nparallel dispatch, constants"
}

consumers -> kernels: "all layers registered, all TUs linked"
kernels -> base: "expression: lowered tree (intersection, geometry);\ncommon: math, parallel, constants"
