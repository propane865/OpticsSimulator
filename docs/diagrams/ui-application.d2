grid-rows: 2
grid-gap: 84

qt: "Qt layer (PySide6)" {
  grid-columns: 2
  grid-gap: 39
  tree: "project_tree.py: source,\nlenses + submodules, planes"
  win: "app.py + main.ui:\nOpticsMainWindow,\nselection hub"
  ed: "editors/: element, source, plane,\nsubmodule, analysis - one page per\nselection, item callbacks"
  pv: "plane_view.py: 2D colormap of\nthe selected plane result"
  widgets: "widgets.py: find_child,\nrun_validated, spin and\nbutton-box setup"
  work: "optimize.py: LayoutOptimizer on a daemon\nthread; progress, finished, failed\nback via Qt signals"

  win <-> tree: selection <-> mirrored list
  win <-> ed
  win -> pv
  ed <-> work
}

free: "Qt-free" {
  grid-rows: 2
  grid-gap: 39
  scene: "scene.py: SceneController (vispy)"
  state: "project/: ProjectState, elements, planes,\npersistence (no PySide6, no vispy)"
  rendering: "rendering/: vispy meshes,\ncolormaps, camera"
  opt: "optics.optimizer: optimize_layout\n(called from the worker thread)"

  scene -> rendering: mesh, colormap build
}

qt -> free: "window: segments, plane images -> scene\neditors: validated apply -> state\nworker: solve -> optics.optimizer"
