grid-rows: 4
grid-gap: 96

cmd: "Editor apply" {
  grid-rows: 2
  grid-gap: 26
  ed: "apply: element, source,\nplane, submodule"
  cls: "classify_element_edit:\nnone, index, transform, geometry"

  ed -> cls: element edit
}

st: "Qt-free state" {
  grid-rows: 2
  grid-gap: 26
  state: "ProjectState: elements, source,\ncached ray arrays"
  sys: "OpticalSystem: persistent native\nTraceStack, rebuilt lazily"

  state -> sys: dropped on any element edit
}

nat: "One native pass" {
  grid-columns: 2
  grid-gap: 26
  fused: trace_segments_and_planes
  segs: "ray segments:\nstarts, ends, hop kinds"
  hits: "plane hits:\n(P, N) -> u, v, power"
  res: "MeasurementResult:\nraw histogram or Wendland C2"

  fused -> segs: "per-hop segments"
  fused -> hits
  hits -> res: "accumulate, reconstruct"
}

views: "Views" {
  grid-columns: 2
  grid-gap: 26
  scene: "SceneController:\nretrace_from_segments,\ngeometry-key mesh cache"
  pview: "plane_view: QImage colormap\nof the selected plane"
}

cmd.cls -> st.state: "none: no retrace, no remesh\nindex: retrace, meshes kept\ntransform, geometry: nodes remeshed"
st -> nat: "cached ray arrays +\nnative stack handle"
nat -> views: "ray segments, detector mesh,\nplane image"
