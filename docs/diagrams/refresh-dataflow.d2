ed: "Editor apply — element, source, plane"
cls: "classify_element_edit — none, index, transform, geometry"
state: "ProjectState — elements, source, cached ray arrays"
sys: "OpticalSystem — one persistent native TraceStack"
fused: "trace_segments_and_planes — single fused native pass"
segs: "Ray segments — starts, ends, hop kinds, per-ray counts"
hits: "Plane hits — u, v, power per ray and plane"
res: "MeasurementResult — raw histogram or Wendland C² reconstruction"
scene: "SceneController — retrace_from_segments, mesh signature cache"
pview: "plane_view — letterboxed QImage colormap"

ed -> cls: element edit
cls -> state: "none, index — no retrace or no remesh"
cls -> state: "transform, geometry — cached system dropped"
state -> sys: "rebuild lazily, only after element edits"
state -> fused: "cached contiguous ray arrays"
sys -> fused: "native stack handle"
fused -> segs: "per-hop segments for rendering"
fused -> hits: "(P, N) hits for every plane"
hits -> res: "accumulate and reconstruct"
segs -> scene: "reuse identical local meshes"
res -> scene: "detector mesh"
res -> pview: "image of the selected plane"
sys -> res: "no fused pass — per-plane measure or plain retrace"
