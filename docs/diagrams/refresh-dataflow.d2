direction: down

cmd: "Editor apply" {
  ed: "apply: element, source, plane"
  cls: "classify_element_edit: none, index, transform, geometry"

  ed -> cls: element edit
}

st: "Qt-free state" {
  state: "ProjectState: elements, source, ray arrays"
  sys: "OpticalSystem: persistent native TraceStack"

  state -> sys: "lazy rebuild after element edits"
}

nat: "One native pass" {
  fused: trace_segments_and_planes
  segs: "ray segments: starts, ends, hop kinds"
  hits: "plane hits: u, v, power"
  res: "MeasurementResult: histogram or Wendland C2"

  fused -> segs: "per-hop segments"
  fused -> hits: "(P, N) hits"
  hits -> res: "accumulate, reconstruct"
}

views: "Views" {
  scene: "SceneController: mesh signature cache"
  pview: "plane_view: QImage colormap"
}

cmd.cls -> st.state: "none, index: no retrace or remesh"
cmd.cls -> st.state: "transform, geometry: system dropped"
st.state -> nat.fused: "cached ray arrays"
st.sys -> nat.fused: "native stack handle"
st.sys -> nat.res: "no fused pass: measure or retrace"
nat.segs -> views.scene: "identical local meshes"
nat.res -> views.scene: "detector mesh"
nat.res -> views.pview: "selected plane image"
