grid-rows: 3
grid-gap: 56

doc: "Project JSON, Zemax .zmx"

py: "Python process" {
  grid-columns: 2
  grid-gap: 39
  scene: "rendering/, ui/scene.py:\nvispy canvases"
  app: "ui/: PySide6 app\n(main.ui, tree, editors,\nplane view, codec)"
  cons: "tests/ and\nbenchmarks/"
  domain: "optics/: elements, trace stack,\nplanes, optimizer"

  app -> scene: "segments, plane images"
  app -> domain
  cons -> domain: "trace, measure API"
}

nat: "Compiled native layer" {
  grid-columns: 2
  grid-gap: 39
  abi: "native/bindings/: pybind11"
  kern: "native/: optics_core,\nC++17 kernels"
  ntests: "native/tests/:\nctest binary, links\nthe whole library"
  pool: "common/parallel.hpp:\nworker pool (parallel\nhops, objective)"

  abi -> kern: "typed entry points"
  kern -> pool
}

doc -> py: "load, import, save"
py -> nat: "NumPy buffers + native handles;\ntests and benchmarks reach _native too"
