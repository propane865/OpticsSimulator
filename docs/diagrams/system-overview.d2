direction: down

py: "Python process" {
  app: "ui/: PySide6 app"
  scene: "rendering/, ui/scene.py: vispy"
  domain: "optics/: elements, trace stack, planes, optimizer"
  cons: "tests/ and benchmarks/"
}

nat: "Compiled native layer" {
  abi: "native/bindings/: pybind11"
  kern: "native/: optics_core, C++17"
  pool: "common/parallel.hpp: thread pool"
}

doc: "Project JSON, Zemax .zmx"

doc -> py.domain: "load, import, save"
py.app -> py.domain: "edits, rebuild"
py.app -> py.scene: "segments, plane images"
py.domain -> nat.abi: "buffers + handles"
nat.abi -> nat.kern: "typed entry points"
nat.kern -> nat.pool: "parallel hops, objective"
py.cons -> py.domain: "trace, measure API"
py.cons -> nat.kern: "ctest over kernel TUs"
