direction: down

ui: "ui/" {
  grid-rows: 3
  grid-gap: 24
  ed: "editors/: element, source, plane,\nsubmodule, analysis (PySide6)"
  core: "core: app, facade, tree, plane view,\noptimize, imagecodec (PySide6)\n+ scene.py (vispy, Qt-free)"
  proj: "project/: ProjectState, persistence\n(Qt-free)"

  ed <-> core: "pages <-> state, callbacks"
  core -> proj: owns ProjectState
}

rendering: "rendering/ (vispy, numpy):\nmeshes, colormaps, camera"

optics: "optics/ (numpy buffers)" {
  grid-rows: 4
  grid-gap: 24
  prim: "primitive/: Ray, Surface, Element parts"
  root: "root: config, element, system,\nplanes, project, expressions"
  opt: "optimizer/: layout solve"
  imp: "importers/zmx/"

  prim <-> root: "constants, _util, expression"
  opt -> root: "rebuild stacks, read planes"
}

abi: "_native: pybind11 boundary, .pyi stubs"

ui -> rendering: "colormaps, canvas"
ui -> optics: "trace, measure, merge .zmx"
rendering -> optics: "surfaces, sidewalls"
optics -> abi: "surface, stack, trace, solve"
