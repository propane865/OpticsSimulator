direction: down

ui: "ui/" {
  core: "core: app, facade, scene, tree, plane view"
  ed: "editors/: element, source, plane, analysis"
  proj: "project/: ProjectState, persistence"

  core <-> ed: "pages <-> widgets, state, callbacks"
  core -> proj: owns ProjectState
}

rendering: "rendering/: vispy meshes, colormaps, camera"

optics: "optics/" {
  root: "root: config, element, system, plane, project, source"
  prim: "primitive/: Ray, Surface, Element parts"
  opt: "optimizer/: layout solve"
  imp: "importers/zmx/"

  root <-> prim: "constants, _util, expression"
  opt -> root: "rebuild stacks, read planes"
}

abi: "_native: pybind11 boundary, .pyi stubs"

third: "third party" {
  pyside: PySide6
  vispy: vispy
  numpy: numpy
}

ui -> optics.root: "trace, measure, build planes"
ui.core -> optics.opt: layout runs
ui.core -> optics.imp: "merge .zmx"
ui.ed -> optics.opt: LensOptimization
rendering -> optics.root: scene geometry
rendering -> optics.prim: "surfaces, sidewalls"
optics -> abi: "surface, stack, trace, solve"
ui.core -> third: "PySide6, vispy"
rendering -> third: "vispy, numpy"
optics -> third: "array buffers"
